NODE_ENV=development
PORT=4000
# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nexgen_hms
# Auth — CHANGE THESE IN PRODUCTION (min 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Sign-in rate limits per 15 minutes
LOGIN_LIMIT_PER_ACCOUNT=20
LOGIN_LIMIT_PER_IP=500
